{
  "manifest_version": 3,
  "name": "PACTHA - Captura Automática",
  "version": "2.4.8",
  "description": "Captura a sessão gov.br/TransfereGov/FNS e envia a TODOS os ambientes PACTHA de uma vez, mostrando o resultado por ambiente. Mostra no ícone quando a sessão do SERVIDOR cai e abre as 4 portas da captura completa. Não captura na tela de login nem no Acesso Livre (visitante): a captura completa sai dele sozinha e avisa na página para entrar com gov.br.",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "tabs",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.gov.br/*",
    "https://gov.br/*",
    "https://pactha.alavank.com.br/*",
    "https://*.sslip.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://idp.transferegov.sistema.gov.br/*",
        "https://*.transferegov.sistema.gov.br/*"
      ],
      "js": ["aviso_pagina.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PACTHA - Captura Automática",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
