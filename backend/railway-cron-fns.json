{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile.scraper"
  },
  "deploy": {
    "restartPolicyType": "NEVER",
    "startCommand": "python -u ingestion/run_fns_local.py",
    "cronSchedule": "30 5 * * *"
  }
}
