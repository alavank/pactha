# Worker p/ scrapers Playwright (SIGCON, TransfereGov Voluntarias).
# Build context = RAIZ do repo, entao COPY usa prefixo backend/.
# No Coolify, este container fica ATIVO rodando o guardiao (reaper.sh) e as
# Scheduled Tasks executam cada cron via `docker exec` (ex.:
# "python -u ingestion/run_sigcon_cron.py").
FROM python:3.12-slim

# Deps de sistema p/ Playwright + tini (init/PID1 de verdade, faz reap de zumbis)
# + procps (pgrep/ps/kill usados pelo reaper.sh).
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg ca-certificates tini procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Instala o Chromium + libs do sistema (essencial: RAILPACK nao faz isso)
RUN playwright install --with-deps chromium

COPY backend/ingestion/ ./ingestion/
COPY backend/models/ ./models/
COPY backend/services/ ./services/
COPY backend/schemas/ ./schemas/
COPY backend/config.py backend/database.py ./
COPY backend/reaper.sh ./reaper.sh
RUN chmod +x ./reaper.sh

# tini como PID 1: encaminha sinais e faz REAP de zumbis. O `sleep infinity`
# anterior nao fazia isso -> Chromium orfao de scraper morto ficava vivo pra
# sempre queimando CPU. O CMD agora e o guardiao: mantem o container vivo E mata
# Chromium orfao quando nenhum scraper esta rodando. Os crons continuam entrando
# normalmente via `docker exec` (o exec ignora ENTRYPOINT/CMD).
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["bash", "/app/reaper.sh"]
