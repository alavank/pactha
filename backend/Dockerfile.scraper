# Worker isolado para scrapers (FNS, SIMEC, etc).
# Sem acesso ao DB direto - so chama API publica.
# Sem credenciais - le do Cofre via Service Token.
FROM python:3.12-slim

# Playwright deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install --with-deps chromium

COPY ingestion/ ./ingestion/

# Comando padrao (override por env CMD_OVERRIDE)
CMD ["python", "ingestion/fns_scraper.py"]
