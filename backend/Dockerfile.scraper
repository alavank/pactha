# Worker p/ scrapers Playwright (SIGCON, TransfereGov Voluntarias).
# Build context = RAIZ do repo, entao COPY usa prefixo backend/.
# No Coolify, este container fica OCIOSO (CMD sleep infinity) e as Scheduled
# Tasks executam cada cron via `docker exec` (ex.:
# "python -u ingestion/run_sigcon_cron.py").
FROM python:3.12-slim

# Deps de sistema p/ Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Instala o Chromium + libs do sistema (essencial: RAILPACK nao faz isso)
RUN playwright install --with-deps chromium

COPY backend/ingestion/ ./ingestion/
COPY backend/models/ ./models/
COPY backend/services/ ./services/
COPY backend/schemas/ ./schemas/
COPY backend/config.py backend/database.py ./

# Container ocioso: as Scheduled Tasks do Coolify executam os crons via docker exec.
CMD ["sleep", "infinity"]
