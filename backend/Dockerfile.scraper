# Worker para scrapers + orquestrador run_all.py
# Build context e ROOT do repo (Railway config: RAILWAY_DOCKERFILE_PATH=backend/Dockerfile.scraper)
# entao todos os COPY usam prefixo backend/.
FROM python:3.12-slim

# Playwright deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install --with-deps chromium

COPY backend/ingestion/ ./ingestion/
COPY backend/models/ ./models/
COPY backend/services/ ./services/
COPY backend/schemas/ ./schemas/
COPY backend/config.py backend/database.py ./

# Orquestrador roda os pipelines do tier configurado via CRON_TIER
# (daily/weekly/monthly/full). Default: weekly.
CMD ["python", "-u", "ingestion/run_all.py"]
