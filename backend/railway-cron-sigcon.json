{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile.scraper"
  },
  "deploy": {
    "restartPolicyType": "NEVER",
    "startCommand": "python ingestion/run_sigcon_cron.py",
    "cronSchedule": "*/5 * * * *"
  }
}
