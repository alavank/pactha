# PACTA - Variaveis de ambiente
# NUNCA COMMITAR .env REAL - usar .env.example apenas

# === BACKEND ===
# DB Neon (rotacionar antes de prod)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT (gerar com: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=GENERATE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Cofre de senhas - chave AES-256 (gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))")
COFRE_KEY=GENERATE_ME

# Producao: ENV=production ativa validacao de JWT_SECRET forte
ENV=production

# CORS: dominio do frontend Railway (sem trailing slash)
FRONTEND_URL=https://pacta.up.railway.app
CORS_ORIGIN_REGEX=^https://pacta(-[a-z0-9]+)?\.up\.railway\.app$

# Admin seed (opcional - se nao definido, gera aleatorio no setup_db.py)
ADMIN_EMAIL=admin@pacta.com.br
# ADMIN_PASSWORD=  # opcional, gera aleatorio se omitido

# === FRONTEND ===
# Service "pacta" no Railway (frontend principal)
NEXT_PUBLIC_API_URL=https://pacta-api.up.railway.app

# === CRON SECRETS ===
# FNS_CPF=
# FNS_SENHA=
