# PACTHA - Variaveis de ambiente
# NUNCA COMMITAR .env REAL - usar .env.example apenas
# Deploy: Coolify (AWS Lightsail 54.232.208.118, sa-east-1) + PostgreSQL puro.
# ATENCAO: sao 3 tenants (freitas / trust / montesiao-mg) rodando este MESMO repo,
# cada um com seu proprio conjunto destas variaveis. Ver INFRA.md na raiz.

# === BACKEND (resource API) ===
# Postgres do Coolify (host interno da rede Docker do projeto). Sem SSL na rede interna.
DATABASE_URL=postgresql+asyncpg://pactha:PASSWORD@HOST_INTERNO_DB:5432/pactha
DATABASE_URL_SYNC=postgresql://pactha:PASSWORD@HOST_INTERNO_DB:5432/pactha?sslmode=disable

# JWT (gerar com: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=GENERATE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Cofre de senhas - chave AES-256 (gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))")
# IMPORTANTE: e UMA CHAVE POR TENANT e ela NUNCA pode mudar depois que o Cofre tiver
# dados. Se trocar, o decrypt() devolve string VAZIA em silencio -- sem erro, sem log --
# e o Cofre de senhas mais as sessoes gov.br daquele cliente viram lixo irrecuperavel.
# As chaves em uso vivem nas env vars do Coolify, uma por tenant. Nao regere por engano.
COFRE_KEY=GENERATE_ME

# Producao: ENV=production ativa cookies Secure + validacao de JWT_SECRET forte
ENV=production

# === BI (Painel de Indicadores) ===
# Flag do modulo nativo de BI. OFF (default) => /api/bi/* nem e montado (404) e o
# app segue byte-identico. Ligue por instancia p/ habilitar o Painel de Indicadores.
BI_MODULE=false
# Frontend (BUILD-TIME, inlined): "1" liga o link de entrada + as paginas /bi.
# NEXT_PUBLIC_BI_MODULE=1

# CORS: dominio do frontend (sem trailing slash). No deploy subpath (front + API no
# MESMO host) o CORS e inocuo por ser same-origin; deixe correto mesmo assim.
FRONTEND_URL=https://pactha.alavank.com.br
# CORS_ORIGIN_REGEX=^https://pactha\.alavank\.com\.br$   # opcional (ex.: previews)

# IA (router /api/ai) e Telegram
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# === O MUNICIPIO DO TENANT (obrigatorio em instancia NOVA) ===
# Sem os tres, o sistema sobe e NAO COLETA NADA — de proposito: base vazia e um
# problema visivel, base com o municipio errado passa semanas despercebida.
# O IBGE tem 7 digitos e e a chave de CAUC/FNS/SISMOB/TransfereGov; errado, as
# fontes devolvem vazio sem dar erro. Ver PROVISIONAR_CLIENTE.md.
MUNICIPIO_NOME=
MUNICIPIO_IBGE=
MUNICIPIO_UF=
INSTANCE_SLUG=

# Admin seed (so usado se a tabela users estiver VAZIA — ou seja, instancia nova).
# NAO defina ADMIN_EMAIL: o default e `super-admin@pactha.com.br`, que esta em
# SUPER_ADMIN_EMAILS. Este campo trazia `admin@pactha.com.br`, removido daquela
# lista em 02/08/2026 por ser adivinhavel — seguindo o exemplo antigo, o tenant
# novo nascia SEM a conta de bootstrap com acesso a Sessoes e Service Tokens.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=  # opcional; se omitido, senha aleatoria impressa no log do 1o boot

# Rodape do Relatorio de Monitoramento — sai no pe de TODA pagina do relatorio
# oficial, entao e o endereco de quem assina. Vazio = sem rodape.
RM_RODAPE=

# === FRONTEND (resource Frontend, BUILD-TIME) ===
# NEXT_PUBLIC_API_URL e inlined no build => defina como BUILD ARG no Coolify.
# DEVE terminar em /api.
NEXT_PUBLIC_API_URL=https://pactha.alavank.com.br/api

# === WORKER / CRONS (resource Worker) ===
# DATABASE_URL_SYNC (mesma da API) + COFRE_KEY (mesma) + service token:
# PACTHA_API_URL=http://HOST_INTERNO_API:8000
# PACTHA_SERVICE_TOKEN=   # crie em /dashboard/service-tokens
# FNS_CPF=
# FNS_SENHA=
